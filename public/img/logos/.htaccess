# Block execution of any scripts in the uploaded logos directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|sh|pl|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -ExecCGI -Indexes

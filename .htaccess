# ==============================================================================
# SimpleAkunting v3.6 - Root Security Configuration
# ==============================================================================

# 1. Nonaktifkan directory browsing & index listings
Options -Indexes -MultiViews

# 2. Lindungi seluruh file sensitif, kredensial, konfigurasi, dan backup
<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|audit_composer\.json|\.cpanel\.ya?ml|\.(sql|bak|backup|old|log|ini|sh|ps1|dump)$|error_log)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Blokir akses browser langsung ke script instalasi, seeder, pembersih data, dan migrasi database
<FilesMatch "^(full_install|seed_users|clean_roles|remove_dummy|create_rbac|update_users_table|debug_roles|debug_perms|debug_users|reset_penyelia|seeder_dummy|migrate.*)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Blokir akses langsung ke folder internal (app, scratch, vendor)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|scratch|vendor)(/.*)?$ - [F,L,NC]
</IfModule>

# 5. Pasang HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Force no-cache on dynamic and html files to prevent browser/proxy stale cache
<FilesMatch "\.(html|htm|php)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# 7. URL Rewriting & Routing
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Subdomain kurasi: jangan rewrite ke public/
    RewriteCond %{HTTP_HOST} ^kurasi\. [NC]
    RewriteRule ^ - [L]

    # Jangan rewrite jika akses langsung ke folder kurasi
    RewriteCond %{REQUEST_URI} ^/kurasi(/|$) [NC]
    RewriteRule ^ - [L]

    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    RewriteRule ^$ public/ [L]
    RewriteRule (.*) public/$1 [L]
</IfModule>
